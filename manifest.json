{
  "manifest_version": 3,
  "name": "MaxVideo Pro — Maximizador de Vídeos & Janela Sem Abas",
  "version": "1.3.4",
  "description": "Maximize qualquer vídeo para preencher a janela e oculte abas, barra de URL e favoritos com 1 clique (Modo Janela Limpa).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "MaxVideo Pro — Controles de Vídeo"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-clean-window": {
      "suggested_key": {
        "default": "Alt+W",
        "windows": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Alternar Janela Limpa (Sem abas, URL e favoritos)"
    },
    "toggle-maximize": {
      "suggested_key": {
        "default": "Alt+M",
        "windows": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Alternar Maximizar Vídeo na Janela"
    },
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+F",
        "windows": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Alternar Tela Cheia Imersiva"
    },
    "download-video": {
      "suggested_key": {
        "default": "Alt+D",
        "windows": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Baixar Vídeo Ativo"
    },
    "toggle-pip": {
      "description": "Alternar Picture-in-Picture"
    }
  }
}
